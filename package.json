{
	"description": "Browser extension that toggles Picture in Picture for videos from the page context menu or popup.",
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"typescript": "^5.9.3",
		"wxt": "^0.20.26"
	},
	"name": "pip-extension",
	"private": true,
	"scripts": {
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"check": "bun run lint && bun run compile",
		"compile": "tsc --noEmit",
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"lint": "biome check .",
		"postinstall": "wxt prepare",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox"
	},
	"type": "module",
	"version": "0.0.0"
}
